#!/usr/bin/env bash
set -u

LOCKFILE="/run/user/$UID/launch-waybar.lock"

exec 9>"$LOCKFILE" || exit 1
flock -n 9 || {
    log "Another launch-waybar instance already running, exiting"
    exit 0
}

SOCKET="/run/rkvm/active.sock"
WAYBAR_CMD="waybar"

LOG_TAG="launch-waybar"
log() {
    printf '[%s] [%s] %s\n' "$(date '+%F %T.%3N')" "$LOG_TAG" "$*" >&2
}

# -----------------------------
# Waybar control
# -----------------------------
waybar_running() {
    pgrep -x waybar >/dev/null 2>&1
}

start_waybar() {
    if waybar_running; then
        log "Waybar already running, not starting"
        return
    fi
    log "Starting Waybar"
    waybar &
}

stop_waybar() {
    if ! waybar_running; then
        log "Waybar already stopped"
        return
    fi
    log "Stopping Waybar"
    pkill -x waybar
}

# -----------------------------
# Init
# -----------------------------
WAYBAR_PID=""
LAST_STATE="unknown"

log "Launcher starting"
start_waybar

# -----------------------------
# Socket loop (streaming)
# -----------------------------
while true; do
    if [[ ! -S "$SOCKET" ]]; then
        log "Socket missing, retrying in 1s"
        sleep 1
        continue
    fi

    log "Connecting to rkvm socket $SOCKET"

    socat - UNIX-CONNECT:"$SOCKET" | while read -r raw; do
        raw="$(echo "$raw" | tr -d '[:space:]')"
        log "Socket event: '$raw'"

        case "$raw" in
            *"=true"|true)
                [[ "$LAST_STATE" != "true" ]] && log "State → true"
                start_waybar
                LAST_STATE="true"
                ;;
            *"=false"|false)
                [[ "$LAST_STATE" != "false" ]] && log "State → false"
                stop_waybar
                LAST_STATE="false"
                ;;
            *)
                log "Ignored unknown value"
                ;;
        esac
    done

    log "Socket disconnected, reconnecting…"
    sleep 0.5
done

