
#!/usr/bin/env bash

HOST="$1"
PORT="$2"

SESSION="ssh"

# Create session with first SSH window if missing
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" "ssh $HOST ${PORT:+-p $PORT}"
else
    tmux new-window -t "$SESSION" "ssh $HOST ${PORT:+-p $PORT}"
fi

# Attach to the session
tmux attach-session -t "$SESSION"

